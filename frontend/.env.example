# База REST API (по умолчанию /api/v1, проксируется на FastAPI в dev)
VITE_API_BASE=/api/v1

# WebSocket-канал карты (по умолчанию вычисляется из адреса страницы)
# VITE_WS_BASE=ws://localhost:8000/api/v1

# Куда vite dev-server проксирует /api (FastAPI backend)
VITE_PROXY_TARGET=http://localhost:8000

# Ключ Yandex Maps JS API 3.0 — карта в стиле Яндекс Go.
# Получить: https://developer.tech.yandex.ru → создать ключ «JavaScript API и HTTP Геокодер».
# Если пусто — приложение работает на MapLibre без ключа.
VITE_YANDEX_API_KEY=

# Fallback-стиль карты для MapLibre (если ключ Yandex не задан)
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
