APP_NAME=Nearby Volunteer Backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Use max in production. dev is rejected outside local/test.
AUTH_MODE=dev
MAX_BOT_TOKEN=
MAX_AUTH_MAX_AGE_SECONDS=3600
MAX_AUTH_FUTURE_SKEW_SECONDS=30
# Trusted MAX IDs that receive/retain ADMIN during signed MAX authentication.
ADMIN_MAX_IDS=
COMMUNITY_GOAL=50000

# DaData address suggestions. Keep these values only in .env / deployment secrets.
DADATA_API_KEY=
DADATA_SECRET_KEY=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nearby
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby_password

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nearby-media
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MEDIA_UPLOAD_MAX_BYTES=10485760
MEDIA_PRESIGN_TTL_SECONDS=900
